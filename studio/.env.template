DB_FILE_NAME=file:local.db
SESSION_SECRET=SOMETHING_SECRET

# Login (TOTP, base32 secret)
TOTP_SECRET=

# Cursor Agent SDK — see https://cursor.com/blog/typescript-sdk
CURSOR_API_KEY=
# Example model slug (check Cursor docs for current list)
AGENT_CURSOR_MODEL=composer-2
# local | cloud (SDK runtime)
AGENT_SDK_RUNTIME=local
# When runtime=local: working directory (e.g. notes repo clone)
AGENT_LOCAL_CWD=
# Optional caps for Navi-side orchestration
AGENT_SESSION_TIMEOUT_MS=
AGENT_MAX_CONCURRENT=

# notes repo path (prompt / tooling context; align with AGENT_LOCAL_CWD when local)
AGENT_NOTES_PATH=

# Session cookie is set with Secure. Use HTTPS or an HTTPS front (e.g. Tailscale Serve)
# when not on localhost; local dev over plain HTTP may need a dev-only cookie tweak in code.
